#!/usr/bin/env bash
# pre-commit hook — fast checks on staged files (< 5s target)
#
# Language-aware: auto-detects Rust (Cargo.toml), Elixir (mix.exs), TypeScript (package.json)
#
# Enforces (all languages):
#   1. No secrets in staged files (API keys, private keys, tokens)
#   2. No .env files committed
#   3. No source file > 250 pure LOC
#   4. Trust-boundary awareness (warning)
#   13. No trailing whitespace (markdown excluded — hard line breaks)
#   14. Files end with a newline
#   15. No unresolved merge conflict markers
#   16. No staged file > 500 KB
#   17. Staged .yml/.yaml parse cleanly (graceful skip without PyYAML)
#   18. Staged .toml parse cleanly (graceful skip without python >= 3.11)
#
# Enforces (Rust):
#   5. No unwrap()/expect() outside #[cfg(test)] (rust-style.md § rule 1)
#   6. No println!/eprintln! outside main.rs (AGENTS.md § conventions)
#   7. No unsafe without // SAFETY: comment (rust-style.md § rule 2)
#   8. cargo fmt --check
#
# Enforces (Elixir):
#   9. No IO.puts/IO.inspect in production files (lib/, not test/)
#  10. mix format --check-formatted
#
# Enforces (TypeScript):
#  11. No console.log in production files (src/, not test/)
#  12. biome check (if configured)
#
# Exit 0 = pass, exit 1 = block commit.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# NUL-delimited staged file list — safe for paths with spaces, glob chars, etc.
mapfile -d '' STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACM -z)

EXIT_CODE=0

# Colors
if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; NC=''
fi

fail() { echo -e "${RED}[pre-commit] FAIL:${NC} $1"; EXIT_CODE=1; }
warn() { echo -e "${YELLOW}[pre-commit] WARN:${NC} $1"; }
info() { echo -e "${GREEN}[pre-commit]${NC} $1"; }

# --- Language detection ---
HAS_RUST=false; HAS_ELIXIR=false; HAS_TS=false
[ -f "$REPO_ROOT/Cargo.toml" ] && HAS_RUST=true
[ -f "$REPO_ROOT/mix.exs" ] && HAS_ELIXIR=true
[ -f "$REPO_ROOT/package.json" ] && HAS_TS=true

# --- Nothing staged? Skip ---
if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

# --- 1. Secret detection (all languages) ---
SECRET_PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ghp_[0-9a-zA-Z]{36}'
  'gho_[0-9a-zA-Z]{36}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'sk_live_[0-9a-zA-Z]{24}'
  'xoxb-[0-9a-zA-Z-]+'
  'AIza[0-9A-Za-z\-_]{35}'
)

for file in "${STAGED_FILES[@]}"; do
  # Read from the index snapshot (staged blob), not the worktree.
  if git show ":$file" 2>/dev/null | file - 2>/dev/null | grep -qi 'text\|json\|yaml\|xml\|empty'; then
    # Skip test files — they contain fake secrets to test the sanitizer
    # (e.g., ghp_1234... in sanitizer_tests.rs). Real secrets in test files
    # are caught by code review (trust-boundary PRs require HITL).
    if [[ "$file" == *"test.rs" || "$file" == *"tests.rs" || "$file" == "tests/"* || "$file" == *"/test.rs" || "$file" == *"/tests.rs" ]]; then
      continue
    fi
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if git show ":$file" 2>/dev/null | grep -nE "$pattern" 2>/dev/null; then
        fail "Potential secret detected in $file (pattern: $pattern)"
      fi
    done
  fi
done

# --- 2. No .env files ---
for file in "${STAGED_FILES[@]}"; do
  if [[ "$file" == ".env" || "$file" == ".env."* || "$file" == *"/.env" || "$file" == *"/.env."* ]]; then
    fail ".env file in staging: $file — use .env.example, add .env to .gitignore"
  fi
done

# --- 3. No source file > 250 pure LOC ---
check_file_size() {
  local file="$1"
  local comment_prefix="$2"
  local pure_loc
  # Read from the index snapshot, not the worktree.
  pure_loc=$(git show ":$file" 2>/dev/null | grep -cvE "^[[:space:]]*$|^[[:space:]]*${comment_prefix}" || true)
  if [ "$pure_loc" -gt 250 ]; then
    fail "$file is ${pure_loc} pure LOC (max 250). Split by responsibility or mark with SIZE_OK."
  fi
}

for file in "${STAGED_FILES[@]}"; do
  case "$file" in
    *.rs)   check_file_size "$file" '//' ;;
    *.ex)   check_file_size "$file" '#' ;;
    *.exs)  check_file_size "$file" '#' ;;
    *.ts)   check_file_size "$file" '//' ;;
    *.tsx)  check_file_size "$file" '//' ;;
  esac
done

# --- 4. Trust-boundary awareness (warning only) ---
# Each repo defines its own trust-boundary files in .github/trust-boundary.yml
# The hook reads it if present; otherwise uses a sensible default list.
TB_CONFIG="$REPO_ROOT/.github/trust-boundary.yml"
if [ -f "$TB_CONFIG" ]; then
  # Extract glob patterns from the YAML (crude but effective)
  TB_PATTERNS=$(grep -E '^\s*-\s*"' "$TB_CONFIG" | sed 's/.*"\(.*\)".*/\1/' || true)
else
  TB_PATTERNS="src/core/laws.rs
src/core/loop.rs
src/budget/
src/update_manager/
src/validation/
Dockerfile
scripts/systemd/
scripts/rollback-watchdog.sh
infra/
.github/workflows/
.github/trust-boundary.yml"
fi

TB_HIT=false
for file in "${STAGED_FILES[@]}"; do
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    if [[ "$file" == "$pattern"* ]]; then
      warn "TRUST-BOUNDARY file staged: $file — PR will require human review (HITL)."
      TB_HIT=true
      break
    fi
  done <<< "$TB_PATTERNS"
done

# Flag .unwrap()/.expect() occurrences that sit outside the file's first
# #[cfg(test)] block. Test files never reach this (is_test_file skips them).
check_rust_cmd() {
  local cmd="$1" lines="$2" file="$3" content="$4"
  [ -z "$lines" ] && return 0
  local cfg_test_count cfg_test_line before_cfg
  cfg_test_count=$(printf '%s\n' "$content" | grep -c '#\[cfg(test)\]' || true)
  if [ "$cfg_test_count" -eq 0 ]; then
    fail "$file contains .$cmd() outside tests. Use ? with context.\n$lines"
  else
    cfg_test_line=$(printf '%s\n' "$content" | grep -n '#\[cfg(test)\]' | head -1 | cut -d: -f1)
    before_cfg=$(echo "$lines" | awk -F: -v cfg_line="$cfg_test_line" '$1 < cfg_line {print}')
    if [ -n "$before_cfg" ]; then
      fail "$file contains .$cmd() outside #[cfg(test)]. Use ? with context.\n$before_cfg"
    fi
  fi
}

# --- 5-8. Rust-specific checks ---
if [ "$HAS_RUST" = true ]; then
  # Filter to .rs files using NUL-safe array operation.
  RUST_FILES=()
  for f in "${STAGED_FILES[@]}"; do
    [[ "$f" == *.rs ]] && RUST_FILES+=("$f")
  done

  if [ ${#RUST_FILES[@]} -gt 0 ]; then
    for file in "${RUST_FILES[@]}"; do
      # Read staged content once — all Rust checks use this snapshot.
      content=$(git show ":$file" 2>/dev/null || true)
      [ -z "$content" ] && continue

      is_test_file=false
      # Test-file detection must match the secrets-skip block in check 1:
      # repo-wide convention is plural *_tests.rs (declared via #[path = "..."]),
      # so *"tests.rs" is REQUIRED here or every *_tests.rs file is treated as
      # production code and .expect()/.unwrap() in tests are false-flagged.
      if [[ "$file" == *"test.rs" || "$file" == *"tests.rs" || "$file" == "tests/"* || "$file" == *"/test.rs" || "$file" == *"/tests.rs" ]]; then
        is_test_file=true
      fi

      # 5. unwrap()/expect() outside tests
      # Pass cmd and lines as SEPARATE arguments: prefixing a label onto
      # multi-line grep output ("expect:142:a\n153:b") and re-splitting it with
      # `cut -d: -f2-` strips the "NNN:" number from every line after the
      # first, silently breaking the cfg(test) position check below.
      if [ "$is_test_file" = false ]; then
        unwrap_lines=$(printf '%s\n' "$content" | grep -n '\.unwrap()' 2>/dev/null || true)
        expect_lines=$(printf '%s\n' "$content" | grep -n '\.expect(' 2>/dev/null || true)
        check_rust_cmd unwrap "$unwrap_lines" "$file" "$content"
        check_rust_cmd expect "$expect_lines" "$file" "$content"
      fi

      # 6. println!/eprintln! outside main.rs
      if [[ "$file" != "src/main.rs" && "$file" != *"/main.rs" ]]; then
        println_lines=$(printf '%s\n' "$content" | grep -n 'println!\|eprintln!' 2>/dev/null || true)
        if [ -n "$println_lines" ]; then
          fail "$file contains println!/eprintln! — use tracing instead.\n$println_lines"
        fi
      fi

      # 7. unsafe without // SAFETY: comment
      unsafe_lines=$(printf '%s\n' "$content" | grep -n 'unsafe' 2>/dev/null | grep -v '// SAFETY:' || true)
      if [ -n "$unsafe_lines" ]; then
        while IFS= read -r line; do
          line_num=$(echo "$line" | cut -d: -f1)
          prev_line=$((line_num - 1))
          if [ "$prev_line" -gt 0 ]; then
            prev_content=$(printf '%s\n' "$content" | sed -n "${prev_line}p" 2>/dev/null || true)
            if echo "$prev_content" | grep -q '// SAFETY:'; then
              continue
            fi
          fi
          if echo "$line" | grep -q '// SAFETY:'; then
            continue
          fi
          fail "$file:$line_num unsafe without // SAFETY: comment.\n$line"
        done <<< "$unsafe_lines"
      fi
    done
  fi

  # 8. cargo fmt --check
  if command -v cargo &>/dev/null; then
    if ! cargo fmt --all -- --check 2>&1; then
      fail "cargo fmt --check failed — run 'cargo fmt --all' to fix."
    fi
  fi
fi

# --- 9-10. Elixir-specific checks ---
if [ "$HAS_ELIXIR" = true ]; then
  EX_FILES=()
  for f in "${STAGED_FILES[@]}"; do
    [[ "$f" == *.ex || "$f" == *.exs ]] && EX_FILES+=("$f")
  done

  if [ ${#EX_FILES[@]} -gt 0 ]; then
    for file in "${EX_FILES[@]}"; do
      # Read staged content once.
      content=$(git show ":$file" 2>/dev/null || true)
      [ -z "$content" ] && continue

      # 9. IO.puts/IO.inspect in production files (lib/, not test/)
      if [[ "$file" == lib/* ]]; then
        io_lines=$(printf '%s\n' "$content" | grep -n 'IO\.puts\|IO\.inspect' 2>/dev/null || true)
        if [ -n "$io_lines" ]; then
          fail "$file contains IO.puts/IO.inspect in production code — use Logger.\n$io_lines"
        fi
      fi
    done
  fi

  # 10. mix format --check-formatted
  if command -v mix &>/dev/null; then
    if ! mix format --check-formatted 2>&1; then
      fail "mix format --check-formatted failed — run 'mix format' to fix."
    fi
  fi
fi

# --- 11-12. TypeScript-specific checks ---
if [ "$HAS_TS" = true ]; then
  TS_FILES=()
  for f in "${STAGED_FILES[@]}"; do
    [[ "$f" == *.ts || "$f" == *.tsx ]] && TS_FILES+=("$f")
  done

  if [ ${#TS_FILES[@]} -gt 0 ]; then
    for file in "${TS_FILES[@]}"; do
      # Read staged content once.
      content=$(git show ":$file" 2>/dev/null || true)
      [ -z "$content" ] && continue

      # 11. console.log in production files (src/, not test/)
      if [[ "$file" == src/* && "$file" != *"test."* && "$file" != *"spec."* ]]; then
        console_lines=$(printf '%s\n' "$content" | grep -n 'console\.log' 2>/dev/null || true)
        if [ -n "$console_lines" ]; then
          fail "$file contains console.log in production code — use a logger.\n$console_lines"
        fi
      fi
    done
  fi

  # 12. biome check (if configured)
  if [ -f "$REPO_ROOT/biome.json" ] && command -v bunx &>/dev/null; then
    if ! bunx biome check 2>&1; then
      fail "biome check failed — run 'bunx biome check --write' to fix."
    fi
  fi
fi

# --- 13-18. File hygiene (absorbed from the org's former pre-commit
# framework config; consolidated here so ONE hook mechanism exists) ---

# 13. Trailing whitespace (markdown excluded: trailing double spaces are
#     hard line breaks there)
#     \r? handles CRLF: matches blanks before optional CR at end of line.
for file in "${STAGED_FILES[@]}"; do
  case "$file" in
    *.md) continue ;;
  esac
  # Read from the index snapshot (staged blob), not the worktree.
  if git show ":$file" 2>/dev/null | file - 2>/dev/null | grep -qi 'text\|json\|yaml\|xml\|empty'; then
    ws_lines=$(git show ":$file" 2>/dev/null | grep -nE '[[:blank:]]+\r?$' 2>/dev/null || true)
    if [ -n "$ws_lines" ]; then
      fail "$file has trailing whitespace.\n$ws_lines"
    fi
  fi
done

# 14. Files end with a newline
for file in "${STAGED_FILES[@]}"; do
  # Read from the index snapshot; skip empty blobs.
  staged_size=$(git show ":$file" 2>/dev/null | wc -c | tr -d ' ' || echo 0)
  [ "$staged_size" -eq 0 ] && continue
  if git show ":$file" 2>/dev/null | file - 2>/dev/null | grep -qi 'text\|json\|yaml\|xml\|empty'; then
    if [ "$(git show ":$file" 2>/dev/null | tail -c 1 | wc -l)" -eq 0 ]; then
      fail "$file does not end with a newline."
    fi
  fi
done

# 15. Unresolved merge conflict markers
for file in "${STAGED_FILES[@]}"; do
  if git show ":$file" 2>/dev/null | file - 2>/dev/null | grep -qi 'text\|json\|yaml\|xml\|empty'; then
    conflict_lines=$(git show ":$file" 2>/dev/null | grep -nE '^(<{7} |={7}$|>{7} )' 2>/dev/null || true)
    if [ -n "$conflict_lines" ]; then
      fail "$file contains unresolved merge conflict markers.\n$conflict_lines"
    fi
  fi
done

# 16. Large staged files (> 500 KB) — Git LFS or split territory
for file in "${STAGED_FILES[@]}"; do
  size_bytes=$(git show ":$file" 2>/dev/null | wc -c | tr -d ' ' || echo 0)
  if [ "$size_bytes" -gt 512000 ]; then
    fail "$file is $((size_bytes / 1024)) KB (max 500 KB). Use Git LFS or split the file."
  fi
done

# 17-18. YAML / TOML parse checks (best-effort: skipped when the parser is
# unavailable — CI runs actionlint/yamllint-style checks regardless)
PY="$(command -v python3 || command -v python || true)"
if [ -n "$PY" ]; then
  YAML_FILES=()
  for f in "${STAGED_FILES[@]}"; do
    [[ "$f" == *.yml || "$f" == *.yaml ]] && YAML_FILES+=("$f")
  done
  if [ ${#YAML_FILES[@]} -gt 0 ] && "$PY" -c 'import yaml' 2>/dev/null; then
    for file in "${YAML_FILES[@]}"; do
      if ! git show ":$file" 2>/dev/null | "$PY" -c "import sys, yaml; yaml.safe_load(sys.stdin)" 2>/dev/null; then
        fail "$file is not valid YAML."
      fi
    done
  fi

  TOML_FILES=()
  for f in "${STAGED_FILES[@]}"; do
    [[ "$f" == *.toml ]] && TOML_FILES+=("$f")
  done
  if [ ${#TOML_FILES[@]} -gt 0 ] && "$PY" -c 'import tomllib' 2>/dev/null; then
    for file in "${TOML_FILES[@]}"; do
      if ! git show ":$file" 2>/dev/null | "$PY" -c "import sys, tomllib; tomllib.load(sys.stdin.buffer)" 2>/dev/null; then
        fail "$file is not valid TOML."
      fi
    done
  fi
fi

# --- Result ---
if [ "$EXIT_CODE" -eq 0 ]; then
  if [ "$TB_HIT" = true ]; then
    info "All checks passed (trust-boundary files detected — PR will require HITL)."
  else
    info "All checks passed."
  fi
else
  echo ""
  echo "pre-commit: commit blocked. Fix the issues above and try again."
  echo "pre-commit: bypass with 'git commit --no-verify' (NOT recommended)."
fi

exit $EXIT_CODE
