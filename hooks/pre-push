#!/usr/bin/env bash
# pre-push hook — slower checks before pushing to remote (< 60s target)
#
# Language-aware: auto-detects Rust (Cargo.toml), Elixir (mix.exs), TypeScript (package.json)
#
# Enforces:
#   Rust:       cargo clippy -D warnings, cargo nextest run, cargo +nightly miri (if unsafe touched)
#   Elixir:     mix credo --strict, mix test
#   TypeScript: bunx tsc --noEmit, bun test
#
# Exit 0 = pass, exit 1 = block push.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXIT_CODE=0

if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; NC=''
fi

fail() { echo -e "${RED}[pre-push] FAIL:${NC} $1"; EXIT_CODE=1; }
warn() { echo -e "${YELLOW}[pre-push] WARN:${NC} $1"; }
info() { echo -e "${GREEN}[pre-push]${NC} $1"; }

# --- Language detection ---
HAS_RUST=false; HAS_ELIXIR=false; HAS_TS=false
[ -f "$REPO_ROOT/Cargo.toml" ] && HAS_RUST=true
[ -f "$REPO_ROOT/mix.exs" ] && HAS_ELIXIR=true
[ -f "$REPO_ROOT/package.json" ] && HAS_TS=true

# --- Determine pushed files ---
PUSHED_FILES=""
while read -r _ local_sha _ remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    RANGE="$local_sha"
  else
    RANGE="${remote_sha}..${local_sha}"
  fi
  PUSHED_FILES=$(git diff --name-only "$RANGE" 2>/dev/null || echo "$local_sha")
done

if [ -z "${PUSHED_FILES:-}" ]; then
  PUSHED_FILES=$(git diff --name-only HEAD 2>/dev/null || true)
fi

cd "$REPO_ROOT"

# --- Push-from-main guard (absorbed from the org's former pre-commit
# framework config "no-commit-to-branch") ---
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
  fail "pushing directly from 'main' is not allowed — work on a feature branch."
fi

# --- Rust checks ---
if [ "$HAS_RUST" = true ]; then
  if ! command -v cargo &>/dev/null; then
    warn "cargo not found — skipping Rust checks."
  else
    info "Running cargo clippy --all-targets --all-features -- -D warnings..."
    if ! cargo clippy --all-targets --all-features -- -D warnings 2>&1; then
      fail "cargo clippy failed. Fix all clippy issues before pushing."
    fi

    if command -v cargo-nextest &>/dev/null; then
      info "Running cargo nextest run..."
      if ! cargo nextest run 2>&1; then
        fail "cargo nextest run failed — tests are failing."
      fi
    else
      info "Running cargo test (install cargo-nextest for better output)..."
      if ! cargo test 2>&1; then
        fail "cargo test failed — tests are failing."
      fi
    fi

    # miri if unsafe touched
    UNSAFE_TOUCHED=false
    for file in $PUSHED_FILES; do
      if [[ "$file" == *.rs ]]; then
        if git show "HEAD:$file" 2>/dev/null | grep -q 'unsafe' 2>/dev/null; then
          UNSAFE_TOUCHED=true; break
        fi
      fi
    done

    if [ "$UNSAFE_TOUCHED" = true ]; then
      if rustup toolchain list 2>/dev/null | grep -q nightly; then
        info "unsafe code detected — running cargo +nightly miri..."
        if ! cargo +nightly miri nextest run 2>&1; then
          fail "cargo +nightly miri failed — UB detected."
        fi
      else
        warn "unsafe code pushed but nightly not installed — skipping miri."
      fi
    fi
  fi
fi

# --- Elixir checks ---
if [ "$HAS_ELIXIR" = true ]; then
  if ! command -v mix &>/dev/null; then
    warn "mix not found — skipping Elixir checks."
  else
    info "Running mix credo --strict..."
    if ! mix credo --strict 2>&1; then
      fail "mix credo --strict failed. Fix credo issues before pushing."
    fi

    info "Running mix test..."
    if ! mix test 2>&1; then
      fail "mix test failed — tests are failing."
    fi
  fi
fi

# --- TypeScript checks ---
if [ "$HAS_TS" = true ]; then
  if ! command -v bunx &>/dev/null; then
    warn "bunx not found — skipping TypeScript checks."
  else
    info "Running bunx tsc --noEmit..."
    if ! bunx tsc --noEmit 2>&1; then
      fail "tsc --noEmit failed — type errors detected."
    fi

    info "Running bun test..."
    if ! bun test 2>&1; then
      fail "bun test failed — tests are failing."
    fi
  fi
fi

# --- Result ---
if [ "$EXIT_CODE" -eq 0 ]; then
  info "All pre-push checks passed."
else
  echo ""
  echo "pre-push: push blocked. Fix the issues above and try again."
  echo "pre-push: bypass with 'git push --no-verify' (NOT recommended)."
fi

exit $EXIT_CODE
