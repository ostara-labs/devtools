# Gitignore for devtools repo
# This repo contains only scripts, configs, and workflows — no compiled code

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Pulumi state (should never be committed)
.pulumi/
pulumi-state/
*.pulumi.yaml.bak

# Node (if any tooling scripts are added later)
node_modules/
dist/

# Temp files
*.tmp
*.bak
*.log
