# Makefile.common — shared shell configuration, help, and tooling.
# Include ONCE at the top of your Makefile, BEFORE the language files:
#   include .devtools/makefiles/Makefile.common
#   include .devtools/makefiles/Makefile.rust
#   ...
#
# Aggregate targets (deps/lint/test/build/format/ci/clean) are NOT defined
# here: define them in YOUR Makefile, calling the suffixed targets provided
# by the language files you included. Absent stacks print "[target] skipped"
# and never fail — so aggregates may reference every suffix unconditionally.

# Shell configuration. NOTE: `SHELL ?=` would be a silent no-op — GNU make
# always pre-defines SHELL (/bin/sh), so ?= never fires. Use := here;
# override AFTER the includes with := if a consumer needs something else.
SHELL      := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.ONESHELL:

.PHONY: help devtools-update hooks

.DEFAULT_GOAL ?= help

help: ## Show this help message
	@awk 'BEGIN {FS = ":.*##"; printf "\033[1mUsage:\033[0m make [target]\n\n"} /^##@/ {printf "\n\033[1m%s\033[0m\n", substr($$0, 5); next} /^[a-zA-Z_-]+:.*##/ {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

devtools-update: ## Update the devtools submodule to the latest tagged version
	@if [ -d ".devtools" ]; then \
		cd .devtools && git fetch origin --tags && git checkout $$(git describe --tags $$(git rev-list --tags --max-count=1)) && cd .. && \
		echo "devtools updated to $$(cd .devtools && git describe --tags)"; \
	else \
		echo "No .devtools submodule found. Run: git submodule add https://github.com/ostara-labs/devtools .devtools"; \
	fi

hooks: ## Activate the devtools git hooks (pre-commit, commit-msg, pre-push)
	@git config core.hooksPath .devtools/hooks && \
		echo "devtools hooks activated: core.hooksPath = .devtools/hooks"
