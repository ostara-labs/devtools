# Makefile.elixir — monorepo targets for the elixir/ stack.
# Included by your Makefile. Every target is guarded: absent stack prints
# "[target] skipped" and never fails.
#
# Overridable variables:
#   ELIXIR_DIR ?= elixir

ELIXIR_DIR ?= elixir

.PHONY: deps-elixir format-elixir lint-elixir test-elixir build-elixir clean-elixir

##@ Elixir

deps-elixir: ## Fetch Elixir dependencies (mix local.hex + mix deps.get)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[deps-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		cd $(ELIXIR_DIR) && mix local.hex --if-missing --force && mix deps.get; \
	fi

format-elixir: ## Format Elixir code (mix format)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[format-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		cd $(ELIXIR_DIR) && mix format; \
	fi

lint-elixir: ## Lint Elixir code (mix format --check-formatted + credo --strict)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[lint-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		cd $(ELIXIR_DIR) && mix format --check-formatted && mix credo --strict; \
	fi

test-elixir: ## Test Elixir code (mix test)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[test-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		cd $(ELIXIR_DIR) && mix test; \
	fi

build-elixir: ## Compile Elixir project (mix compile)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[build-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		cd $(ELIXIR_DIR) && mix compile; \
	fi

clean-elixir: ## Remove Elixir build artifacts (_build, deps)
	@if [ ! -f $(ELIXIR_DIR)/mix.exs ]; then \
		echo "[clean-elixir] skipped (no $(ELIXIR_DIR)/mix.exs)"; \
	else \
		rm -rf $(ELIXIR_DIR)/_build $(ELIXIR_DIR)/deps; \
	fi
