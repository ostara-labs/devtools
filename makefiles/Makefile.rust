# Makefile.rust — monorepo targets for the rust/ stack.
# Included by your Makefile. Every target is guarded: absent stack prints
# "[target] skipped" and never fails, so aggregates may reference them all.
#
# Overridable variables (define in YOUR Makefile BEFORE/AFTER include):
#   RUST_DIR ?= rust

RUST_DIR ?= rust

.PHONY: deps-rust format-rust lint-rust test-rust build-rust clean-rust

##@ Rust

deps-rust: ## Fetch Rust crates (cargo fetch)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[deps-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && cargo fetch; \
	fi

format-rust: ## Format Rust code (cargo fmt)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[format-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && cargo fmt --all; \
	fi

lint-rust: ## Lint Rust code (cargo fmt --check + clippy -D warnings)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[lint-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings; \
	fi

test-rust: ## Test Rust code (cargo-nextest if available, else cargo test)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[test-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && (command -v cargo-nextest >/dev/null 2>&1 && cargo nextest run || cargo test); \
	fi

build-rust: ## Build Rust release binary (cargo build --release)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[build-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && cargo build --release; \
	fi

clean-rust: ## Clean Rust build artifacts (cargo clean)
	@if [ ! -f $(RUST_DIR)/Cargo.toml ]; then \
		echo "[clean-rust] skipped (no $(RUST_DIR)/Cargo.toml)"; \
	else \
		cd $(RUST_DIR) && cargo clean; \
	fi
