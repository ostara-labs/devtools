# =============================================================================
# Template des variables d'entrée du script scripts/install.sh.
#
# Copiez ce fichier en `.env` (gitignoré) et ajustez les valeurs si besoin.
# Le script crée automatiquement `.env` depuis ce template s'il n'existe pas,
# et ne l'écrase jamais ensuite.
#
# Le script résout aussi DONGLE_PATH (chemin série persistant du dongle Zigbee)
# et l'écrit dans `.env` à la phase 3.
# =============================================================================

# Fuseau horaire injecté dans les conteneurs.
TZ=Europe/Paris

# Canal Zigbee (25 ou 26 — éviter les canaux Wi-Fi 1, 6, 11).
ZIGBEE_CHANNEL=25

# Clé d'authentification Tailscale (optionnel). Si vide, le script affiche
# l'URL de login interactive.
# TAILSCALE_AUTHKEY=

# Nom d'hôte optionnel du mini PC (optionnel). Si vide, le nom d'hôte système
# est conservé.
# HOSTNAME=
